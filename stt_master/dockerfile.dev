FROM golang:1.27.3-alpine

# Устанавливаем GCC и необходимые библиотеки для компиляции SQLite (CGO)
RUN apk add --no-cache gcc musl-dev

# Устанавливаем Air для live-reload (автоперезапуск при изменении кода)
RUN go install github.com/air-verse/air@latest

WORKDIR /app

# Оставляем контейнер ожидать команду запуска от Air
CMD ["air", "-c", ".air.toml"]
