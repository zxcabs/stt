FROM golang:1.27.3-alpine AS go-builder
RUN apk add --no-cache git gcc musl-dev
WORKDIR /app
COPY go.mod go.sum* ./
RUN go mod download
COPY ./cmd ./cmd
COPY ./internal ./internal
RUN CGO_ENABLED=1 GOOS=linux go build -ldflags="-w -s" -o master-server ./cmd/server/main.go

FROM node:24-slim AS http-builder
WORKDIR /app
COPY ./web_src/*.js*  ./
COPY ./web_src/*.ts  ./
RUN npm ci
COPY ./web_src/src ./src
COPY ./web_src/public ./public
COPY ./web_src/index.html ./
RUN npm run build

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
WORKDIR /app
COPY --from=go-builder /app/master-server .
COPY --from=http-builder /app/dist ./web
COPY --from=http-builder /app/public ./web
EXPOSE 8080
CMD ["./master-server"]